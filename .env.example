# Add your own OpenRouter API key to enable AI chat.
# Leave empty to browse the demo and admin pages without calling an AI API.
OPENROUTER_API_KEY=

# app = vulnerable research variant; app_hardened = prompt-hardened variant.
TICKETORACLE_VARIANT=app

# Host port; always published on 127.0.0.1 only.
TICKETORACLE_PORT=8000

# Separate structured POST experiment; defaults to the hardened prompt.
TICKETORACLE_STRUCTURED_PORT=8001
TICKETORACLE_STRUCTURED_VARIANT=app_hardened

# Run a banner-only SSH test target on port 22 inside the container only.
# Set to 0 to disable it.
TICKETORACLE_PORT22_TEST=1
